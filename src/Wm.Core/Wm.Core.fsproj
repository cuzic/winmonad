<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Wm.Coreは外部パッケージ依存を持たない（architecture.md §17「依存の例外」） -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DomainEvents.fs" />
    <Compile Include="DecisionTrace.fs" />
    <Compile Include="Topology.fs" />
    <Compile Include="Workspaces.fs" />
    <Compile Include="Health.fs" />
    <Compile Include="Focus.fs" />
    <Compile Include="Windows.fs" />
    <Compile Include="Placement.fs" />
    <Compile Include="WmState.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- §17依存方向：Wm.Core（Contracts・Policy・Layouts）。PlacementのReconcileがLayoutRegistry/
         PlanValidatorを呼ぶため、ADR-019実装順14のPlacementのPending/Desiredラウンドでようやく追加した。 -->
    <ProjectReference Include="../Wm.Contracts/Wm.Contracts.fsproj" />
    <ProjectReference Include="../Wm.Policy/Wm.Policy.fsproj" />
    <ProjectReference Include="../Wm.Layouts/Wm.Layouts.fsproj" />
  </ItemGroup>

</Project>
